# ─────────────────────────────────────────────────────────────────────────────
# LexAI Environment Template
# ─────────────────────────────────────────────────────────────────────────────
# 1. Copy this file:  cp .env.example .env
# 2. Fill in every value marked with <...>
# 3. Never commit .env to git (it's in .gitignore)
# ─────────────────────────────────────────────────────────────────────────────

# ─── Server (AWS Lightsail public IP or domain) ───────────────────────────────
# Run `curl ifconfig.me` on your Lightsail instance to get the public IP.
# This is used by Nginx, CORS, and MinIO presigned URLs.
SERVER_IP=<your-lightsail-public-ip>

# ─── Google Gemini ────────────────────────────────────────────────────────────
GOOGLE_API_KEY=<your-google-api-key>

# ─── Postgres ─────────────────────────────────────────────────────────────────
# In Docker, the app connects to the postgres service by container name.
# These values are only needed for running locally outside Docker.
POSTGRES_URL=postgresql+asyncpg://lexai:lexai@127.0.0.1:5433/lexai
POSTGRES_SYNC_URL=postgresql://lexai:lexai@127.0.0.1:5433/lexai
POSTGRES_PASSWORD=lexai

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Qdrant ───────────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=lexai_chunks

# ─── Neo4j ────────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=lexai_neo4j

# ─── MinIO ────────────────────────────────────────────────────────────────────
# MINIO_ENDPOINT     → used by the backend/workers to talk to MinIO internally.
#                      In Docker this is overridden to http://minio:9000.
MINIO_ENDPOINT=http://localhost:9000

# MINIO_PUBLIC_URL   → embedded in presigned links the browser opens.
#                      Must be reachable from the user's browser.
#                      Set to http://<SERVER_IP>:9000 (port 9000 is exposed).
MINIO_PUBLIC_URL=http://<your-lightsail-public-ip>:9000

MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=lexai-documents

# ─── Auth / JWT ───────────────────────────────────────────────────────────────
# IMPORTANT: Change this to a long random secret before deploying!
# Generate one with: openssl rand -hex 32
JWT_SECRET=<change-this-to-a-long-random-secret>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ─── Application ──────────────────────────────────────────────────────────────
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
# CORS: allow requests from the Nginx-proxied frontend
CORS_ORIGINS='["http://<your-lightsail-public-ip>", "http://localhost:3000"]'

# ─── Celery ───────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ─── Frontend (Next.js) ───────────────────────────────────────────────────────
# IMPORTANT: This is baked into the browser bundle at Docker build time.
# Set to http://<SERVER_IP> (no port — Nginx serves everything on port 80).
NEXT_PUBLIC_API_URL=http://<your-lightsail-public-ip>

# ─── Local dev only ───────────────────────────────────────────────────────────
# These are only used when running services directly (not via Docker Compose).
NETWORK_IP=192.168.X.X
